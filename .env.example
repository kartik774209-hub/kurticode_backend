# ─── Server ──────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB Atlas ────────────────────────────────────────────────────
# Get your connection string from: MongoDB Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Legacy alias (also supported):
# MONGODB_URL=

# ─── JWT ──────────────────────────────────────────────────────────────
# Use a long random string — never share this
SECRET_KEY=replace_with_a_long_random_secret_string

# ─── Frontend URL (CORS) ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# ─── Cloudinary (image uploads) ──────────────────────────────────────
# Get from: Cloudinary Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=arerzgij
CLOUDINARY_API_KEY=377858157771498
CLOUDINARY_API_SECRET=Stwdxp96wbiLxCqJI0pEQBkixGw

# ─── Brevo Transactional Email ────────────────────────────────────────
# 1. Sign up at https://app.brevo.com
# 2. Go to SMTP & API → API Keys → Create a new API key
# 3. Verify your sender email at Senders & IPs
BREVO_API_KEY=xkeysib-replace-with-your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@email.com
BREVO_SENDER_NAME=Kurti Cove

# ─── Cryptr ───────────────────────────────────────────────────────────
CRYPTR_SECRET=replace_with_a_long_random_secret

# ─── UPI Payments (Frontend also needs these) ─────────────────────────
# Set NEXT_PUBLIC_STORE_UPI_ID in your frontend .env.local file
# NEVER put your real UPI ID here — use environment variables only
